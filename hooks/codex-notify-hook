#!/usr/bin/env python3
"""Codex `notify` program: codex passes one JSON argument, e.g.
{"type":"agent-turn-complete","thread-id":"...","cwd":"...","last-assistant-message":"..."}.
Forwards it to notifyd. Never blocks or fails codex."""
import json
import os
import socket
import sys

try:
    data = json.loads(sys.argv[1])
    if data.get("type") == "agent-turn-complete":
        msg = {"type": "hook", "tool": "codex", "event": "agent-turn-complete", "session_id": data.get("thread-id"),
               "cwd": data.get("cwd"), "message": data.get("last-assistant-message") or ""}
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(1)
        s.connect(os.environ.get("NOTIFYD_SOCKET", os.path.expanduser("~/.local/state/notifyd/notifyd.sock")))
        s.sendall((json.dumps(msg) + "\n").encode())
        s.close()
except Exception:
    pass
sys.exit(0)
